#!/usr/bin/env bash
# This script lists files in the current directory and prints only the part of the name after the first dash

for file in *; do
    # Ignore hidden files (those starting with .)
    if [[ -f "$file" || -d "$file" ]]; then
        # Extract the part after the first dash, or the whole name if no dash
        echo "${file#*-}"
    fi
done
